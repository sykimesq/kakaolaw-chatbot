# ── LLM (OpenRouter) ──────────────────────────────
# provider: "mock" | "openrouter"
LLM_PROVIDER=mock
# 모델 ID (openrouter): 오픈빌더 스킬 timeout(5초) 안 응답용으로 빠른 무료 모델 사용
# 예) poolside/laguna-s-2.1:free (약 2.6초, 서버에서 측정 완료 — 권장)
#     nvidia/nemotron-3-nano-30b-a3b:free (약 1초, 가장 빠름)
#     nvidia/nemotron-3-super-120b-a12b:free (약 11초, 오픈빌더에선 timeout — 지양)
LLM_MODEL=poolside/laguna-s-2.1:free
# OpenRouter API 키 (https://openrouter.ai/settings/keys)
# ※ 일반 사용(User) 키를 사용하세요. 관리(management/provisioning) 키는 채팅 호출 불가.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
