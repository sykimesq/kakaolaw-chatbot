# ── LLM (OpenRouter) ──────────────────────────────
# provider: "mock" | "openrouter"
LLM_PROVIDER=mock
# 모델 ID (openrouter): 오픈빌더 스킬 timeout(5초) 안 응답용으로 빠른 무료 모델 사용
# 예) poolside/laguna-xs-2.1:free (약 2.2초, 서버에서 측정 완료 — 최종 선택, timeout 안전)
#     poolside/laguna-s-2.1:free (약 4.2~5.2초, timeout 경계 — 지양)
#     nvidia/nemotron-3-nano-30b-a3b:free (약 1초, 가장 빠르나 reasoning 노출 — 사용 불가)
LLM_MODEL=poolside/laguna-xs-2.1:free
# OpenRouter API 키 (https://openrouter.ai/settings/keys)
# ※ 일반 사용(User) 키를 사용하세요. 관리(management/provisioning) 키는 채팅 호출 불가.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ── 추론(콜백) 모델 ────────────────────────────────
# 오픈빌더 콜백(useCallback)을 쓰면 1분 여유가 생기므로, 5초 안에는 대기 메시지만
# 보내고 실제 되묻기 질문은 이해력 좋은 추론 모델이 생성해 콜백으로 전송한다.
# ⚠️ 오픈빌더 관리자에서 해당 스킬의 '콜백 사용'을 ON 해야 동작한다.
USE_CALLBACK=true
# 폴백 체인: "provider:model" 콤마 구분, 앞에서부터 시도. provider = nous | openrouter
# 실측(2026-08-16): solar-pro4:free 1.3~2.2초, '상간소송' 등 법률 용어 정확히 이해.
#   tencent/hy3:free 는 빈 응답을 반환해 2순위로 배치(빈 응답 시 자동 다음 모델).
REASONING_MODELS=nous:upstage/solar-pro4:free,nous:tencent/hy3:free,openrouter:nvidia/nemotron-3-ultra-550b-a55b:free
# 체인 내 각 모델 호출 타임아웃(초)
REASONING_TIMEOUT=40
# Nous Portal API 키 (https://portal.nousresearch.com)
NOUS_PORTAL_API_KEY=
NOUS_BASE_URL=https://inference-api.nousresearch.com/v1
# 콜백 전송 어댑터: real(실제 POST) | mock(테스트)
CALLBACK_ADAPTER=real

# ── Docker Compose 배포 변수 (compose.yaml에서 사용) ──────────────
# APP_NAME: 컨테이너 이름 접두사
APP_NAME=kakaolaw
# WEB_PORT: 호스트에서 localhost로 노출할 포트 (127.0.0.1 전용, Cloudflare Tunnel 경유)
WEB_PORT=8600
# WEB_IMAGE: 명시적 이미지 태그 (never 'latest')
WEB_IMAGE=kakaolaw-web:2026.08.16
# WEB_MEM_LIMIT: 메모리 제한
WEB_MEM_LIMIT=512m

