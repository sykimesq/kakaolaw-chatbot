# ── LLM (OpenRouter) ──────────────────────────────
# provider: "mock" | "openrouter"
LLM_PROVIDER=mock
# 모델 ID (openrouter): 예) nvidia/nemotron-3-super-120b-a12b:free
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# OpenRouter API 키 (https://openrouter.ai/settings/keys)
# ※ 일반 사용(User) 키를 사용하세요. 관리(management/provisioning) 키는 채팅 호출 불가.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
