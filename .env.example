# ── LLM (OpenRouter) ──────────────────────────────
# provider: "mock" | "openrouter"
LLM_PROVIDER=mock
# 모델 ID (openrouter): 오픈빌더 스킬 timeout(5초) 안 응답용으로 빠른 무료 모델 사용
# 예) poolside/laguna-xs-2.1:free (약 2.2초, 서버에서 측정 완료 — 최종 선택, timeout 안전)
#     poolside/laguna-s-2.1:free (약 4.2~5.2초, timeout 경계 — 지양)
#     nvidia/nemotron-3-nano-30b-a3b:free (약 1초, 가장 빠르나 reasoning 노출 — 사용 불가)
LLM_MODEL=poolside/laguna-xs-2.1:free
# OpenRouter API 키 (https://openrouter.ai/settings/keys)
# ※ 일반 사용(User) 키를 사용하세요. 관리(management/provisioning) 키는 채팅 호출 불가.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ── Docker Compose 배포 변수 (compose.yaml에서 사용) ──────────────
# APP_NAME: 컨테이너 이름 접두사
APP_NAME=kakaolaw
# WEB_PORT: 호스트에서 localhost로 노출할 포트 (127.0.0.1 전용, Cloudflare Tunnel 경유)
WEB_PORT=8600
# WEB_IMAGE: 명시적 이미지 태그 (never 'latest')
WEB_IMAGE=kakaolaw-web:2026.08.16
# WEB_MEM_LIMIT: 메모리 제한
WEB_MEM_LIMIT=512m

